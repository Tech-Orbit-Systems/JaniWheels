# ---------------------------------------------------------------------------
# Database
# Local:  postgresql://postgres:postgres@localhost:5432/janiwheels
# Neon:   postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/janiwheels?sslmode=require
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Site
# NEXT_PUBLIC_SITE_URL must be the canonical absolute origin, no trailing slash.
# It is used to build canonical tags, sitemaps and JSON-LD. Getting this wrong
# silently breaks SEO, so it is validated at boot in src/lib/env.ts
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=JaniWheels
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
SESSION_SECRET=change-me-to-32-plus-random-bytes

# Google OAuth web client. Configure these in Google Cloud and register the
# exact callback URL: <NEXT_PUBLIC_SITE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Account-verification and password-reset email. In local development, links
# are printed in the server terminal when these are blank. Production requires
# both values and a verified sending domain.
RESEND_API_KEY=
EMAIL_FROM=JaniWheels <accounts@janiwheels.com>

# ---------------------------------------------------------------------------
# Images — local development or Cloudflare Images
# ---------------------------------------------------------------------------
IMAGE_PROVIDER=local          # local | cloudflare
NEXT_PUBLIC_IMAGE_PROVIDER=local  # match IMAGE_PROVIDER
NEXT_PUBLIC_CF_IMAGES_HASH=
# Absolute path for the `local` provider. Leave blank to use
# <cwd>/.uploads (outside public/) — pin it if the server is started from a
# directory other than the project root, or uploads silently vanish.
UPLOAD_DIR=
CF_IMAGES_ACCOUNT_ID=
CF_IMAGES_API_TOKEN=
CF_IMAGES_SIGNING_KEY=
# Predefined variant with never-exceed 2400px dimensions; never allow public access.
CF_IMAGES_PRIVATE_VARIANT=private

# ---------------------------------------------------------------------------
# Search uses PostgreSQL. No external search-provider setting is consumed in V1.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Scheduled jobs. POST /api/cron/{expire-listings|purge-expired|saved-search-alerts|deliver-search-alerts}
# with header:  Authorization: Bearer <CRON_SECRET>
# Required — the endpoint 401s without it, because expire-listings is
# destructive. purge-expired also removes unclaimed uploads older than 24h.
# ---------------------------------------------------------------------------
CRON_SECRET=

# Approved retention: enable only after migrations, preview and restore-ledger setup.
RETENTION_ENABLED=false
RETENTION_DATABASE_NAME=
# Keep a restored backup offline until deletion replay succeeds.
RESTORE_REPLAY_REQUIRED=false
# Actual provider configuration must also enforce this rolling backup window.
BACKUP_RETENTION_DAYS=30
