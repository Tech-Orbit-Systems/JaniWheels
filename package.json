{
  "name": "janiwheels",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:safe": "cross-env NEXT_DIST_DIR=.next-build next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:env": "node --import tsx scripts/check-env.ts && node --import tsx scripts/check-health.ts",
    "check:deployment": "node --import tsx scripts/check-deployment.ts --launch",
    "check:seo": "node --import tsx scripts/check-seo.ts",
    "check:visibility": "node --import tsx scripts/check-listing-visibility.ts",
    "check:publication": "node --import tsx scripts/check-instant-publication.ts",
    "check:seller-flows": "node --import tsx scripts/check-seller-flows.ts",
    "check:uploads": "node --conditions=react-server --import tsx scripts/check-upload-security.ts && node --conditions=react-server --import tsx scripts/check-cloudflare-images.ts",
    "check:recently-viewed": "node --import tsx scripts/check-recently-viewed.ts",
    "check:buyer-discovery": "node --import tsx scripts/check-buyer-discovery.ts",
    "check:account-management": "node --conditions=react-server --import tsx scripts/check-account-management.ts",
    "check:dealer-management": "node --conditions=react-server --import tsx scripts/check-dealer-management.ts",
    "check:google-auth": "node --conditions=react-server --import tsx scripts/check-google-first-auth.ts",
    "check:admin-controls": "node --conditions=react-server --import tsx scripts/check-admin-controls.ts",
    "check:inspection-admin": "node --conditions=react-server --import tsx scripts/check-inspection-admin.ts",
    "check:sell-assistance": "node --conditions=react-server --import tsx scripts/check-sell-assistance.ts",
    "check:legal-content": "node --import tsx scripts/check-legal-content.ts",
    "check:map-location": "node --import tsx scripts/check-map-location.ts",
    "check:branding-responsive": "node --import tsx scripts/check-branding-responsive.ts",
    "sweep": "node --conditions=react-server --import tsx scripts/sweep.ts",
    "test:db": "node --conditions=react-server --import tsx --test tests/database.acceptance.test.ts tests/admin-bootstrap.acceptance.test.ts tests/alerts.acceptance.test.ts tests/retention.acceptance.test.ts",
    "test:load-smoke": "node --import tsx scripts/load-smoke.ts",
    "benchmark:browse": "node --import tsx scripts/benchmark-browse.ts",
    "retention:inventory": "node --import tsx scripts/retention-inventory.ts",
    "retention": "node --conditions=react-server --import tsx scripts/retention.ts",
    "admin:bootstrap": "node --import tsx scripts/bootstrap-admin.ts",
    "test:e2e": "playwright test",
    "test:acceptance:prepare": "node --import tsx scripts/prepare-acceptance-db.ts",
    "test:acceptance": "node --import tsx scripts/run-acceptance.ts",
    "check": "npm run typecheck && npm run check:env && npm run check:seo && npm run check:visibility && npm run check:publication && npm run check:seller-flows && npm run check:uploads && npm run check:recently-viewed && npm run check:buyer-discovery && npm run check:account-management && npm run check:dealer-management && npm run check:google-auth && npm run check:admin-controls && npm run check:inspection-admin && npm run check:sell-assistance && npm run check:legal-content && npm run check:map-location && npm run check:branding-responsive",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:repair:google-auth": "tsx scripts/repair-local-google-auth-schema.ts",
    "db:repair:map-location": "tsx scripts/repair-local-map-location-schema.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed/run.ts",
    "db:reset": "drizzle-kit push --force && npm run db:seed"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.10",
    "lucide-react": "^0.475.0",
    "next": "^15.5.26",
    "postgres": "^3.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "slugify": "^1.6.6",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/google.maps": "^3.66.2",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "axe-core": "4.13.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.19.0",
    "eslint-config-next": "^15.5.26",
    "postcss": "^8.5.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.28"
    }
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
