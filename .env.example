# ---------------------------------------------------------------------------
# Database
# Local:  postgresql://postgres:postgres@localhost:5432/janiwheels
# Neon:   postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/janiwheels?sslmode=require
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Site
# NEXT_PUBLIC_SITE_URL must be the canonical absolute origin, no trailing slash.
# It is used to build canonical tags, sitemaps and JSON-LD. Getting this wrong
# silently breaks SEO, so it is validated at boot in src/lib/env.ts
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=JaniWheels

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
SESSION_SECRET=change-me-to-32-plus-random-bytes

# Password reset email. In local development, reset links are printed in the
# server terminal when these are blank. Production requires both values and a
# verified sending domain.
RESEND_API_KEY=
EMAIL_FROM=JaniWheels <accounts@janiwheels.com>

# ---------------------------------------------------------------------------
# Images — Cloudflare Images or S3-compatible (R2/MinIO)
# ---------------------------------------------------------------------------
IMAGE_PROVIDER=local          # local | cloudflare | s3
# Absolute path for the `local` provider. Leave blank to use
# <cwd>/public/uploads — but pin it if the server is ever started from a
# directory other than the project root, or uploads silently vanish.
UPLOAD_DIR=
CF_IMAGES_ACCOUNT_ID=
CF_IMAGES_API_TOKEN=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Search (Phase 2 — Postgres FTS is used until this is set)
# ---------------------------------------------------------------------------
TYPESENSE_HOST=
TYPESENSE_API_KEY=

# ---------------------------------------------------------------------------
# Scheduled jobs. POST /api/cron/{expire-listings|purge-expired}
# with header:  Authorization: Bearer <CRON_SECRET>
# Required — the endpoint 401s without it, because expire-listings is
# destructive. purge-expired also removes unclaimed uploads older than 24h.
# ---------------------------------------------------------------------------
CRON_SECRET=
